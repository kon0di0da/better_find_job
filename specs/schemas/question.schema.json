{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.local/schemas/question.schema.json",
  "title": "Question",
  "allOf": [
    {"$ref": "#/$defs/QuestionCreate"},
    {
      "type": "object",
      "required": ["question_id", "version", "review_status", "enabled"],
      "properties": {
        "question_id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "review_status": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "enabled": {"type": "boolean"}
      }
    }
  ],
  "$defs": {
    "QuestionCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "stem", "difficulty", "skill_tags", "rubric_version"],
      "properties": {
        "type": {"enum": ["PROJECT", "FOUNDATION", "SYSTEM_DESIGN", "OPEN_LOGIC"]},
        "stem": {"type": "string", "minLength": 1, "maxLength": 5000},
        "difficulty": {"enum": ["JUNIOR", "MID", "SENIOR"]},
        "skill_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "rubric_version": {"type": "string"}
      }
    }
  }
}
