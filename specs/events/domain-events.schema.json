{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.local/events/event-envelope.schema.json",
  "title": "DomainEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "aggregate_id", "occurred_at", "idempotency_key", "trace_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["ResumeParsed", "ResumeDeletionRequested", "JDStructured", "QuestionApproved", "InterviewPlanReady", "AnswerSubmitted", "InterviewCompleted", "AssessmentPublished", "DeletionCompleted"]},
    "event_version": {"type": "integer", "minimum": 1},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
    "trace_id": {"type": "string", "minLength": 1},
    "payload": {"oneOf": [
      {"$ref": "#/$defs/resumeParsed"},
      {"$ref": "#/$defs/resumeDeletionRequested"},
      {"$ref": "#/$defs/jdStructured"},
      {"$ref": "#/$defs/questionApproved"},
      {"$ref": "#/$defs/interviewPlanReady"},
      {"$ref": "#/$defs/answerSubmitted"},
      {"$ref": "#/$defs/interviewCompleted"},
      {"$ref": "#/$defs/assessmentPublished"},
      {"$ref": "#/$defs/deletionCompleted"}
    ]}
  },
  "$defs": {
    "resumeParsed": {"type": "object", "required": ["resume_id", "resume_version_id", "status"], "properties": {"resume_id": {"type": "string", "format": "uuid"}, "resume_version_id": {"type": "string", "format": "uuid"}, "status": {"enum": ["SUCCEEDED", "FAILED"]}}},
    "resumeDeletionRequested": {"type": "object", "required": ["deletion_job_id", "subject_hash", "scope", "deadline_at"], "properties": {"deletion_job_id": {"type": "string", "format": "uuid"}, "subject_hash": {"type": "string"}, "scope": {"type": "string"}, "deadline_at": {"type": "string", "format": "date-time"}}},
    "jdStructured": {"type": "object", "required": ["jd_id", "version", "skill_count"], "properties": {"jd_id": {"type": "string", "format": "uuid"}, "version": {"type": "integer"}, "skill_count": {"type": "integer", "minimum": 0}, "warning_codes": {"type": "array", "items": {"type": "string"}}}},
    "questionApproved": {"type": "object", "required": ["question_id", "question_version_id"], "properties": {"question_id": {"type": "string", "format": "uuid"}, "question_version_id": {"type": "string", "format": "uuid"}}},
    "interviewPlanReady": {"type": "object", "required": ["plan_id", "item_count", "allocation"], "properties": {"plan_id": {"type": "string", "format": "uuid"}, "item_count": {"const": 10}, "allocation": {"type": "object"}}},
    "answerSubmitted": {"type": "object", "required": ["session_id", "answer_id", "question_index", "status"], "properties": {"session_id": {"type": "string", "format": "uuid"}, "answer_id": {"type": "string", "format": "uuid"}, "question_index": {"type": "integer", "minimum": 1, "maximum": 10}, "status": {"enum": ["ANSWERED", "UNANSWERED"]}}},
    "interviewCompleted": {"type": "object", "required": ["session_id", "answer_count"], "properties": {"session_id": {"type": "string", "format": "uuid"}, "answer_count": {"const": 10}}},
    "assessmentPublished": {"type": "object", "required": ["assessment_id", "session_id", "status", "total_score"], "properties": {"assessment_id": {"type": "string", "format": "uuid"}, "session_id": {"type": "string", "format": "uuid"}, "status": {"enum": ["PUBLISHED", "NEEDS_REVIEW"]}, "total_score": {"type": "number", "minimum": 0, "maximum": 100}}},
    "deletionCompleted": {"type": "object", "required": ["deletion_job_id", "completed_at", "receipt_hashes"], "properties": {"deletion_job_id": {"type": "string", "format": "uuid"}, "completed_at": {"type": "string", "format": "date-time"}, "receipt_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  }
}
